# ---------- Ambiente ----------
NODE_ENV=development

# ---------- API ----------
API_PORT=3333
# Origens autorizadas (CORS e verificação de Origin no Socket.IO), separadas por vírgula
WEB_ORIGIN=http://localhost:5173
# URL pública da SPA, usada para montar o link do QR Code
PUBLIC_WEB_URL=http://localhost:5173
# Confie no proxy reverso (X-Forwarded-*) — use 1 atrás de nginx/load balancer
TRUST_PROXY=0
LOG_LEVEL=info

# ---------- Banco e Redis ----------
DATABASE_URL=postgresql://azhoot:azhoot@localhost:5432/azhoot?schema=public
TEST_DATABASE_URL=postgresql://azhoot:azhoot@localhost:5432/azhoot_test?schema=public
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
# Em produção o Redis tem senha: redis://:SENHA@redis:6379/0
# (veja .env.production + docker-compose.prod.yml — pnpm prod:up)

# ---------- Segurança ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-com-64-caracteres-hex-antes-de-usar
ADMIN_SESSION_TTL_HOURS=12
PARTICIPANT_TOKEN_TTL_HOURS=12

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# ---------- Seed do proprietário (usado apenas por pnpm db:seed) ----------
SEED_OWNER_NAME=Proprietário
SEED_OWNER_EMAIL=owner@azhoot.local
SEED_OWNER_PASSWORD=
# Cria um quiz de demonstração publicado (apenas desenvolvimento)
SEED_DEMO_QUIZ=true

# ---------- Cobrança (Asaas) ----------
# Opcional: sobrepõe a chave e o token configurados no Painel master → Configurações.
# Sem chave, em desenvolvimento, as cobranças usam o pagamento simulado (/pagamento-simulado/:id).
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# URL pública da API (usada para montar a URL do webhook). Padrão: PUBLIC_WEB_URL.
PUBLIC_API_URL=
# Em produção o simulador fica bloqueado; use 1 apenas em ambientes de homologação.
BILLING_ALLOW_SIMULATED=0
# 1 desliga as rotinas periódicas (cobrança, avisos de vencimento, relatório semanal).
DISABLE_JOBS=0

# ---------- IA (geração de perguntas) ----------
# Opcional: sobrepõe a chave configurada no Painel master → Configurações → IA.
# Sem chave, em desenvolvimento, a geração usa um provedor simulado.
OPENAI_API_KEY=
# Em produção o simulador de IA fica bloqueado; use 1 apenas em homologação.
AI_ALLOW_SIMULATED=0
