    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
