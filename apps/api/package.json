    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "mammoth": "1.11.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
