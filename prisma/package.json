{
  "name": "@azhoot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "./schema.prisma",
    "seed": "tsx ./seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../.env -- tsx ./seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "migrate:sql": "dotenv -e ../.env -- tsx ./scripts/migrate-sql.ts",
    "migrate:test": "dotenv -e ../.env -- tsx ./scripts/migrate-sql.ts --test"
  },
  "dependencies": {
    "@azhoot/contracts": "workspace:*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@azhoot/config-eslint": "workspace:*",
    "@azhoot/config-typescript": "workspace:*",
    "@types/node": "22.20.4",
    "@types/pg": "8.15.6",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
